// Config holds the configuration for connecting to the SurrealDB instance.
type Config struct {
	Address   string
	Namespace string
	Database  string
	Username  string
	Password  string

	// ExpiryPurgeInterval controls how often expired records are purged from
	// tables with an expiry (TTL) configured. Defaults to one minute when unset.
	// It has no effect if no model embeds som.Expiry.
	ExpiryPurgeInterval time.Duration

	// Strict marks the database as strict on creation, so that no resource can
	// be used before it has been defined. Since som generates a complete schema,
	// this turns any access to an undefined table into an error instead of
	// silently creating it.
	//
	// It only takes effect for a database that does not exist yet: an existing
	// database keeps whatever mode it was created with.
	Strict bool

	// Reconnect controls how a lost WebSocket connection is recovered. The
	// zero value keeps the driver defaults, which reconnect automatically.
	Reconnect ReconnectConfig

	// OnStatus, if set, is called with each change of the connection status:
	// when the connection is lost, at each attempt to reconnect and its
	// outcome, and when the client closes. Events arrive one at a time and in
	// order, on a goroutine of their own. Only clients which reconnect report
	// changes.
	OnStatus func(ConnectionEvent)
}

// ReconnectConfig controls how a lost WebSocket connection is recovered.
//
// On reconnect, the namespace, database and authentication are restored. Open
// transactions are lost, and live queries end with a query.LiveDisconnected
// result, as they cannot be restored. Requests in flight when the connection
// was lost fail and may or may not have run on the server.
type ReconnectConfig struct {
	// Disabled turns reconnecting off, so that a lost connection closes the
	// client for good.
	Disabled bool

	// MinDelay is the base of the backoff between attempts, which doubles with
	// each attempt. Defaults to one second when unset.
	MinDelay time.Duration

	// MaxDelay caps the backoff between attempts. Defaults to one minute when
	// unset.
	MaxDelay time.Duration

	// MaxAttempts is how many attempts in a row are made before the client
	// gives up and closes. Defaults to 5 when unset. A negative value means no
	// limit.
	MaxAttempts int
}

func (c ReconnectConfig) options() []surrealdb.Option {
	if c.Disabled {
		return []surrealdb.Option{surrealdb.WithReconnect(false)}
	}

	options := []surrealdb.Option{
		surrealdb.WithReconnectDelay(c.MinDelay, c.MaxDelay),
	}

	if c.MaxAttempts != 0 {
		options = append(options, surrealdb.WithReconnectAttempts(c.MaxAttempts))
	}

	return options
}

// ConnectionEvent reports a change of the client's connection status.
type ConnectionEvent = surrealdb.StatusEvent

// ConnectionStatus is the state of the client's connection.
type ConnectionStatus = surrealdb.ConnectionStatus

const (
	StatusConnected    = surrealdb.StatusConnected
	StatusDisconnected = surrealdb.StatusDisconnected
	StatusReconnecting = surrealdb.StatusReconnecting
	StatusClosed       = surrealdb.StatusClosed
)

// sessionRestoreTimeout bounds signing in again after a reconnect.
const sessionRestoreTimeout = 30 * time.Second

type dbConn struct {
	conn        *surrealdb.DB
	purgeCancel context.CancelFunc
}

func (c *dbConn) ensureTx(ctx context.Context) (*surrealdb.Transaction, error) {
	state := internal.GetTxState(ctx)
	if state == nil {
		return nil, nil
	}
	raw, err := state.EnsureTx(func() (any, error) {
		return c.conn.Begin(ctx)
	})
	if err != nil {
		return nil, err
	}
	tx, ok := raw.(*surrealdb.Transaction)
	if !ok {
		return nil, fmt.Errorf("unexpected transaction type: %T", raw)
	}
	return tx, nil
}

func dbSelect[T any](ctx context.Context, db *dbConn, id *models.RecordID) (*T, error) {
	if id == nil {
		return nil, som.ErrNilID
	}
	tx, err := db.ensureTx(ctx)
	if err != nil {
		return nil, err
	}
	if tx != nil {
		return surrealdb.Select[T](ctx, tx, *id)
	}
	return surrealdb.Select[T](ctx, db.conn, *id)
}

func dbCreate[T any](ctx context.Context, db *dbConn, id models.RecordID, data any) (*T, error) {
	tx, err := db.ensureTx(ctx)
	if err != nil {
		return nil, err
	}
	if tx != nil {
		return surrealdb.Create[T](ctx, tx, id, data)
	}
	return surrealdb.Create[T](ctx, db.conn, id, data)
}

func dbCreateNew[T any](ctx context.Context, db *dbConn, target string, data any) (*T, error) {
	statement := fmt.Sprintf("CREATE %s CONTENT $data", target)
	vars := map[string]any{"data": data}
	tx, err := db.ensureTx(ctx)
	if err != nil {
		return nil, err
	}
	var result *[]surrealdb.QueryResult[[]T]
	if tx != nil {
		result, err = surrealdb.Query[[]T](ctx, tx, statement, vars)
	} else {
		result, err = surrealdb.Query[[]T](ctx, db.conn, statement, vars)
	}
	if err != nil {
		return nil, err
	}
	if result == nil || len(*result) == 0 {
		return nil, som.ErrEmptyResponse
	}
	qr := (*result)[0]
	if qr.Error != nil {
		return nil, fmt.Errorf("create failed: %w", qr.Error)
	}
	if len(qr.Result) == 0 {
		return nil, som.ErrEmptyResponse
	}
	return &qr.Result[0], nil
}

