// fragmentInfo holds the projection and the fragment-specific conversion
// functions of a fragment model. It is registered by the generated code.
type fragmentInfo[F any] struct {
	// Fields lists the database fields the fragment projects, id included.
	Fields []string

	// UnmarshalAll unmarshals query results into []*F.
	UnmarshalAll func(data []byte) ([]*F, error)

	// UnmarshalOne unmarshals a single result into *F.
	UnmarshalOne func(data []byte) (*F, error)

	// FieldsOf returns the DB-keyed value map for a fragment, using DB field
	// names and DB-typed values. Used to derive pagination cursor values.
	FieldsOf func(*F) map[string]any
}

// fragmentRegistry maps a fragment model type to its fragmentInfo. A generic
// method only knows the fragment type, not its conversion functions, so they
// are looked up here instead of being passed in.
var fragmentRegistry sync.Map // reflect.Type -> fragmentInfo[F]

func registerFragment[F any](info fragmentInfo[F]) {
	fragmentRegistry.Store(reflect.TypeFor[F](), info)
}

func fragmentInfoFor[F any]() (fragmentInfo[F], error) {
	typ := reflect.TypeFor[F]()

	val, ok := fragmentRegistry.Load(typ)
	if !ok {
		return fragmentInfo[F]{}, fmt.Errorf("no fragment registered for type %s", typ)
	}

	info, ok := val.(fragmentInfo[F])
	if !ok {
		return fragmentInfo[F]{}, fmt.Errorf("fragment registered for type %s has an unexpected type %T", typ, val)
	}

	return info, nil
}

// AllAs returns all records matching the conditions of the query, narrowed to
// the fields of the fragment F. The returned instances are partial, so they
// cannot be written back to the database.
func (b builder[M]) AllAs[F som.FragmentOf[M]](ctx context.Context) ([]*F, error) {
	info, err := fragmentInfoFor[F]()
	if err != nil {
		return nil, err
	}

	req := b.query.BuildAsFragment(info.Fields)

	res, err := b.db.Query(ctx, req.Statement, req.Variables)
	if err != nil {
		return nil, fmt.Errorf("could not query records: %w", err)
	}

	return info.UnmarshalAll(res)
}

// AllAsAsync is the asynchronous version of AllAs.
func (b builder[M]) AllAsAsync[F som.FragmentOf[M]](ctx context.Context) *asyncResult[[]*F] {
	return async(ctx, b.AllAs[F])
}

// FirstAs returns the first record matching the conditions of the query,
// narrowed to the fields of the fragment F.
func (b builder[M]) FirstAs[F som.FragmentOf[M]](ctx context.Context) (*F, error) {
	b.query.Limit = 1

	res, err := b.AllAs[F](ctx)
	if err != nil {
		return nil, err
	}
	if len(res) < 1 {
		return nil, som.ErrNotFound
	}

	return res[0], nil
}

// FirstAsAsync is the asynchronous version of FirstAs.
func (b builder[M]) FirstAsAsync[F som.FragmentOf[M]](ctx context.Context) *asyncResult[*F] {
	return async(ctx, b.FirstAs[F])
}

// IterateAs behaves like Iterate, but yields records narrowed to the fields of
// the fragment F.
//
// The keyset cursor is derived from the projected fields, so a sort field that
// the fragment does not hold is added to the projection to keep paging stable.
func (b builder[M]) IterateAs[F som.FragmentOf[M]](ctx context.Context, batchSize int) iter.Seq2[*F, error] {
	return func(yield func(*F, error) bool) {
		if batchSize < 1 {
			yield(nil, errors.New("batch size must be positive"))
			return
		}

		info, err := fragmentInfoFor[F]()
		if err != nil {
			yield(nil, err)
			return
		}

		sorts := b.totalOrderSorts()
		whereLen := len(b.query.Where)
		start := b.query.Start
		yielded := 0

		keyset := !b.query.SortRandom
		var cursor *lib.CursorData

		for {
			batchBuilder := b
			batchBuilder.query.Sort = sorts
			batchBuilder.query.Limit = batchSize
			batchBuilder.query.Start = start + yielded

			if cursor != nil {
				batchBuilder.query.Where = append(b.query.Where[:whereLen:whereLen], lib.CursorFilter[M](*cursor, sorts, false))
				batchBuilder.query.Start = 0
			}

			results, err := batchBuilder.AllAs[F](ctx)
			if err != nil {
				yield(nil, err)
				return
			}

			if len(results) == 0 {
				return
			}

			for _, frag := range results {
				if !yield(frag, nil) {
					return
				}
				yielded++
			}

			if len(results) < batchSize {
				return
			}

			if keyset {
				data, err := cursorDataOf(info.FieldsOf(results[len(results)-1]), sorts)
				if err != nil {
					keyset, cursor = false, nil
					continue
				}
				cursor = &data
			}
		}
	}
}

// DescribeAs returns a string representation of the query as it is run by the
// ...As terminals for the fragment F. While this might be a valid SurrealDB
// query, it should only be used for debugging purposes.
func (b builder[M]) DescribeAs[F som.FragmentOf[M]]() string {
	info, err := fragmentInfoFor[F]()
	if err != nil {
		return ""
	}

	return strings.TrimSpace(b.query.BuildAsFragment(info.Fields).Statement)
}

// LiveAs behaves like Live, but delivers records narrowed to the fields of the
// fragment F.
//
// Note: for delete notifications the database only sends the record id, so the
// received fragment holds no field values.
func (b Builder[M]) LiveAs[F som.FragmentOf[M]](ctx context.Context) (<-chan LiveResult[*F], error) {
	info, err := fragmentInfoFor[F]()
	if err != nil {
		return nil, err
	}

	req := b.query.BuildAsLiveFragment(info.Fields)

	resChan, err := b.db.Live(ctx, req.Statement, req.Variables)
	if err != nil {
		return nil, fmt.Errorf("failed to query live records: %w", err)
	}

	return live(ctx, resChan, modelInfo[F]{UnmarshalOne: info.UnmarshalOne}), nil
}
