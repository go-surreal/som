//go:build embed

package types

import (
	"fmt"
	"net/url"

	"{{.GenerateOutPath}}/internal/cbor"
)

// URL wraps url.URL and provides CBOR marshaling for SurrealDB.
// It is stored as a plain string.
type URL url.URL

func (u *URL) MarshalCBOR() ([]byte, error) {
	if u == nil {
		return cbor.None(), nil
	}

	data, err := cbor.Marshal((*url.URL)(u).String())
	if err != nil {
		return nil, fmt.Errorf("failed to marshal url: %w", err)
	}

	return data, nil
}

func (u *URL) UnmarshalCBOR(data []byte) error {
	if cbor.IsNoneOrNull(data) {
		*u = URL{}
		return nil
	}

	var val string

	if err := cbor.Unmarshal(data, &val); err != nil {
		return fmt.Errorf("failed to unmarshal url: %w", err)
	}

	res, err := url.Parse(val)
	if err != nil {
		return fmt.Errorf("failed to parse url %q: %w", val, err)
	}

	*u = URL(*res)

	return nil
}
